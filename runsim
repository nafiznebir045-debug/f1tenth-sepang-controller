#!/usr/bin/env bash
# ==============================================================================
# F1TENTH Autonomous Racing - Simulation & Controller Launcher
# Course: Autonomous Vehicles
# Track: Sepang International Circuit (Group 3)
# Driver: Nevir Nafiz Molla
# ==============================================================================

# Ensure script halts cleanly on Ctrl+C or terminal close
cleanup() {
    echo -e "\n\033[1;33m[!] Stopping all simulation nodes and RViz...\033[0m"
    pkill -f "gym_bridge" 2>/dev/null || true
    pkill -f "gap_node" 2>/dev/null || true
    pkill -f "rviz2" 2>/dev/null || true
    pkill -f "map_server" 2>/dev/null || true
    pkill -f "lifecycle_manager" 2>/dev/null || true
    pkill -f "robot_state_publisher" 2>/dev/null || true
    exit 0
}
trap cleanup SIGINT SIGTERM SIGHUP

# Clean up any leftover processes from previous runs before starting
pkill -f "gym_bridge" 2>/dev/null || true
pkill -f "gap_node" 2>/dev/null || true
pkill -f "rviz2" 2>/dev/null || true
pkill -f "map_server" 2>/dev/null || true
pkill -f "lifecycle_manager" 2>/dev/null || true
pkill -f "robot_state_publisher" 2>/dev/null || true
sleep 0.5

# Ensure WSLg X11/Wayland display variables are set
export DISPLAY="${DISPLAY:-:0}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

# Isolate ROS 2 traffic from LAN / other network nodes
export ROS_LOCALHOST_ONLY=1
export ROS_DOMAIN_ID=42

# Robustly resolve script location even if invoked through symlinks
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

# Fallback to standard project path if needed
if [ ! -d "$SCRIPT_DIR/src/f1tenth_gym_ros" ]; then
    if [ -d "/home/admin1/Downloads/nebirAssaignment-main/src/f1tenth_gym_ros" ]; then
        SCRIPT_DIR="/home/admin1/Downloads/nebirAssaignment-main"
    elif [ -d "/mnt/d/nebirAssaignment/src/f1tenth_gym_ros" ]; then
        SCRIPT_DIR="/mnt/d/nebirAssaignment"
    fi
fi

cd "$SCRIPT_DIR"

# 1. Source ROS 2 system installation
if [ -f "/opt/ros/jazzy/setup.bash" ]; then
    source /opt/ros/jazzy/setup.bash
elif [ -f "/opt/ros/humble/setup.bash" ]; then
    source /opt/ros/humble/setup.bash
else
    echo -e "\033[1;31mError: No ROS 2 installation found in /opt/ros!\033[0m"
    exit 1
fi

# 2. Check and build workspace if needed, and always sync latest Python/RViz sources into build/
if [ ! -f "$SCRIPT_DIR/install/setup.bash" ]; then
    echo -e "\033[1;33m[*] Building workspace with colcon...\033[0m"
    colcon build --symlink-install
else
    if [ -d "$SCRIPT_DIR/build/controllers/controllers" ]; then
        cp -f "$SCRIPT_DIR/src/controllers/controllers/"*.py "$SCRIPT_DIR/build/controllers/controllers/" 2>/dev/null || true
    fi
    if [ -d "$SCRIPT_DIR/build/f1tenth_gym_ros/f1tenth_gym_ros" ]; then
        cp -f "$SCRIPT_DIR/src/f1tenth_gym_ros/f1tenth_gym_ros/"*.py "$SCRIPT_DIR/build/f1tenth_gym_ros/f1tenth_gym_ros/" 2>/dev/null || true
    fi
fi

# 3. Source local workspace
source "$SCRIPT_DIR/install/setup.bash"

echo -e "\033[1;36m==============================================================\033[0m"
echo -e "\033[1;32m🏎️   F1TENTH AUTONOMOUS RACING SIMULATION RUNNER\033[0m"
echo -e "\033[1;37m    Group: 3 | Student: Nevir Nafiz Molla\033[0m"
echo -e "\033[1;37m    Track: Sepang International Circuit\033[0m"
echo -e "\033[1;37m    Challenges: 10 Laps No Collision & Fastest Lap Time\033[0m"
echo -e "\033[1;36m==============================================================\033[0m"

echo -e "\n\033[1;34m[*] Launching F1TENTH Simulator & RViz2 (logs -> /tmp/f1tenth_sim.log)...\033[0m"
ros2 launch f1tenth_gym_ros gym_bridge_launch.py > /tmp/f1tenth_sim.log 2>&1 &
SIM_PID=$!

# Allow simulator and RViz 3.5 seconds to initialize
sleep 3.5

echo -e "\n\033[1;32m[*] Starting Follow-the-Gap Controller...\033[0m"
echo -e "\033[1;35m📊 Live Telemetry Dashboard : http://localhost:8088\033[0m\n"
ros2 run controllers gap_node

wait $SIM_PID
